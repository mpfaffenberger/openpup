# ======================================================================
# OpenPup configuration. Copy to `.env` and fill in what you need.
# Every section is optional — only configure the platforms you want on.
# ======================================================================

# ---- Identity & agent ------------------------------------------------
OPENPUP_NAME=OpenPup
# "auto" generates an agent named after your pup (with full code-puppy tooling).
# Set an explicit code-puppy agent name to drive that one instead.
OPENPUP_AGENT=auto
# Persona presets used to generate ~/.openpup/SOUL.md (edit via `openpup persona`).
# personality: warm_loyal_sassy | sharp_dry | calm_pro | chaotic_retriever
OPENPUP_PERSONALITY=warm_loyal_sassy
# proactivity: relentless | proactive | balanced | reserved
OPENPUP_PROACTIVITY=relentless
# Model name as configured in your code-puppy setup (~/.code_puppy).
# Leave blank to use code-puppy's global default model.
OPENPUP_MODEL=
# Optional cheaper model used for low-stakes heartbeat reflection ticks.
OPENPUP_REFLECTION_MODEL=
# Universal Constructor: let the agent build its own tools at runtime (create/call/list).
OPENPUP_UNIVERSAL_CONSTRUCTOR=true

# ---- Owner / human ---------------------------------------------------
# Primary owner address (default destination for proactive outreach): "platform:channel"
# e.g. telegram:123456789  or  discord:998877  or  sms:+15559876543 (YOUR cell)
OPENPUP_OWNER_ADDRESS=
# Owner across multiple platforms (comma-separated). The owner is recognized and
# reachable at ANY of these, e.g. "telegram:123456789,sms:+15559876543".
OPENPUP_OWNER_ADDRESSES=

# ---- Outbound comms governance --------------------------------------
# Who the agent may message: open | contacts | owner_only
OPENPUP_SEND_POLICY=open
# Per-platform outbound message cap per minute (runaway/spam guard).
OPENPUP_SEND_RATE_PER_MIN=10

# ---- Inbound security -------------------------------------------------
# Scan NON-owner messages for prompt-injection patterns (instruction
# override, secret fishing, impersonation, embedded payloads) and warn the
# agent inline. Advisory only — never blocks. Owner messages never scanned.
OPENPUP_THREAT_GUARD=true
# Seconds the owner has to answer an approval request ("yes <id>" / "no <id>").
# Unanswered requests are denied when this expires.
OPENPUP_APPROVAL_TIMEOUT_S=300

# ---- Memory (puppy_kennel) ------------------------------------------
# Defaults to <OPENPUP_HOME>/kennel (~/.openpup/kennel); uncomment to relocate.
# PUPPY_KENNEL_ROOT=~/.openpup/kennel

# ---- Heartbeat -------------------------------------------------------
OPENPUP_HEARTBEAT_ENABLED=true
# Base seconds between heartbeat ticks.
OPENPUP_HEARTBEAT_INTERVAL=900
# Random +/- jitter (seconds) applied to each interval.
OPENPUP_HEARTBEAT_JITTER=120
# How often to check the scheduler + poll inbound (seconds). Kept short so
# reminders/jobs fire on time instead of waiting for the slow heartbeat.
OPENPUP_SCHEDULER_INTERVAL=30
# Behaviors: any of reflect,outreach,routines,inbound,curator (comma separated).
# "curator" is opt-in: it maintains agent-created skills (see Curator below).
OPENPUP_HEARTBEAT_BEHAVIORS=reflect,outreach,routines,inbound
# Quiet hours (24h local), no proactive outreach in this window. Blank = always.
OPENPUP_QUIET_HOURS=23-7
# Max proactive outreach messages per day (spam guard).
OPENPUP_OUTREACH_MAX_PER_DAY=4

# ---- Curator (agent-skill maintenance) -------------------------------
# Opt-in: add "curator" to OPENPUP_HEARTBEAT_BEHAVIORS. Periodically reviews
# skills the agent created for itself; archives (never deletes) idle ones.
# User-installed and pinned skills are never touched.
# Hours between curator runs (168 = weekly).
OPENPUP_CURATOR_INTERVAL_HOURS=168
# Agent-created skills idle this many days get flagged for review.
OPENPUP_CURATOR_STALE_AFTER_DAYS=30
# Agent-created skills idle this many days get archived (recoverable).
OPENPUP_CURATOR_ARCHIVE_AFTER_DAYS=90

# ---- Webhook server (WhatsApp / SMS / Telegram-webhook inbound) ------
OPENPUP_WEB_ENABLED=false
OPENPUP_WEB_HOST=0.0.0.0
OPENPUP_WEB_PORT=8080
OPENPUP_WEBHOOK_SECRET=

# ---- Discord ---------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=

# ---- Telegram --------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# ---- WhatsApp (Meta Cloud API) --------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- Email (read-only inbox sensor; IMAP in, SMTP out) --------------
# Email is ONE-WAY: the pup reads your inbox on demand (and from scheduled
# checks) but never auto-replies to incoming mail. To watch your inbox, ask
# the pup to schedule a recurring openpup_check_email job.
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ---- iMessage (macOS native, no external service) --------------------
# Requires Full Disk Access (read chat.db) + Automation permission (send).
IMESSAGE_ENABLED=false
IMESSAGE_POLL_SECONDS=5
IMESSAGE_DB_PATH=~/Library/Messages/chat.db

# ---- SMS (Twilio or direct ModemManager bridge) ----------------------
SMS_ENABLED=false
# twilio | modem
SMS_BACKEND=twilio
# Direct modem only: receive MMS through mmsd-tng + the host bridge.
MMS_ENABLED=false
# MODEM_BRIDGE_URL=http://127.0.0.1:9081
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio-OWNED number you bought (the SENDER), in E.164. NOT your cell.
TWILIO_FROM_NUMBER=
# (Your personal cell goes in OPENPUP_OWNER_ADDRESS / OPENPUP_OWNER_ADDRESSES as sms:+1...)
# Direct modem backend only: ModemManager handles multipart SMS above one
# segment; cap total response length to avoid accidental SMS spam.
# MODEM_SMS_MAX_CHARS=1500
